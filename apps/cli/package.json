{
  "name": "meetfy",
  "version": "1.1.0",
  "description": "CLI tool for creating instant meetings and reserving time in Google Calendar",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "meetfy": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint",
    "deploy": "npm publish"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cli",
    "meeting",
    "google-calendar",
    "typescript"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardoborges/meetfy"
  },
  "devDependencies": {
    "@googleapis/calendar": "^12.0.0",
    "@types/node": "25.4.0",
    "@types/react": "^18.3.29",
    "commander": "14.0.3",
    "conf": "15.1.0",
    "dayjs": "^1.11.20",
    "google-auth-library": "10.6.1",
    "open": "11.0.0",
    "oxlint": "^1.20.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mishieck/ink-titled-box": "^0.4.2",
    "ink": "^5.2.1",
    "ink-divider": "^4.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-tab": "^5.2.0",
    "ink-table": "^3.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  }
}
